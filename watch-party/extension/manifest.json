{
  "manifest_version": 3,
  "name": "Couch — Watch Party",
  "version": "0.1.0",
  "description": "Host synchronized Netflix watch parties with a built-in group video & audio call. Everyone shares playback controls.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Couch Watch Party",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "*://*.netflix.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.netflix.com/watch/*"],
      "js": ["src/vendor/peerjs.min.js", "src/content.js"],
      "css": ["src/overlay/overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/injected.js"],
      "matches": ["*://*.netflix.com/*"]
    }
  ]
}
